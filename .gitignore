# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Course briefs and working templates stay local; my own report is published
# because the README links to it.
docs/*.pdf
!docs/UserTesting_Report_Sift.pdf

# Native projects are generated by `npx expo prebuild` and are not committed:
# they are a build artefact of app.json, so committing them invites drift.
/android
/ios

# Release signing key (generated locally, never published)
/credentials
/dist
